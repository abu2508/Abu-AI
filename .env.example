# Copy to .env (never commit .env). Generate real values with:
#   ./infrastructure/scripts/gen-secrets.sh
# Secrets must be URL-safe (hex) because they are embedded in database URLs.

ABU_ENV=development

# --- PostgreSQL (one server, separate logical databases and users) ---
POSTGRES_ADMIN_USER=abu_admin
POSTGRES_ADMIN_PASSWORD=change-me
APP_DB_NAME=abu_ai
APP_DB_USER=abu_app
APP_DB_PASSWORD=change-me
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=change-me
# STAGING / PRODUCTION only (docker-compose.hardened.yml). A separate OWNER role runs migrations; APP_DB_USER above then
# becomes the least-privilege RUNTIME role. Leave these unset for development (single-role behaviour, unchanged).
# APP_DB_OWNER_USER=abu_owner
# APP_DB_OWNER_PASSWORD=change-me

# --- LiteLLM proxy ---
# Must start with "sk-". Used by the API to talk to LiteLLM; never ship to the mobile app.
LITELLM_MASTER_KEY=sk-change-me

# --- API authentication (server-side only; never ship to the mobile app) ---
# >= 32 chars, must differ from each other. gen-secrets.sh creates both.
JWT_SECRET=change-me-change-me-change-me-change-me
TOKEN_HASH_KEY=change-me-change-me-change-me-change-me

# --- Memory encryption ---
# Master keys live in secrets/memory-keyring.json (created by gen-secrets.sh), NOT here and NOT in
# the database. Embeddings: only the deterministic local TEST embedder exists (lexical, not semantic).
# It is refused in production unless you explicitly set this to true.
ALLOW_TEST_EMBEDDER_IN_PRODUCTION=false
# uid the api/admin containers run as (the owner of secrets/memory-keyring.json). gen-secrets.sh sets it.
ABU_UID=10001

# --- Provider API keys ---
# Intentionally empty. Paid providers are disabled by default (monthly cap: INR 300).
# Do not add a key until a model is registered, approved and explicitly opted in.

# --- Staging / production deployment (see docs/operations/DEPLOYMENT.md) ---
# ABU_ENV is set by the environment overlay (staging|production), not here. STAGING uses synthetic data only and
# must set ALLOW_TEST_EMBEDDER_IN_PRODUCTION=true to say so explicitly; production refuses the test embedder (gate G4).
# STAGING_HTTPS_PORT=8443          # loopback-only port Caddy listens on in staging
# ABU_DOMAIN=                      # production only; no default on purpose
# ABU_ACME_EMAIL=                  # production only; no default on purpose
# DB_MEM_LIMIT=1g
# LITELLM_MEM_LIMIT=2g
# API_MEM_LIMIT=768m
