{
  "name": "abu-ai-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "api:types": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.d.ts",
    "api:types:check": "node scripts/check-generated-types.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "check:audit": "node scripts/audit-gate.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:all": "npm run check:sdk && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run api:types:check && npm run check:licenses && npm run check:install-scripts && npm run check:audit && npm run check:transport && npm run check:secrets",
    "export:web": "expo export --platform web",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:sdk": "node scripts/check-sdk-alignment.mjs",
    "test:coverage": "jest --coverage",
    "test:contract": "node --env-file=.contract.env node_modules/jest/bin/jest.js --config jest.contract.config.js",
    "contract:run": "bash scripts/contract-backend.sh run",
    "contract:up": "bash scripts/contract-backend.sh up",
    "contract:down": "bash scripts/contract-backend.sh down",
    "check:transport": "node scripts/check-transport.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.108.4",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-device": "58.0.5",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-symbols": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "test-exclude@7.0.2": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    },
    "@jest/reporters": {
      "glob": "14.0.6"
    },
    "jest-config": {
      "glob": "14.0.6"
    },
    "jest-runtime": {
      "glob": "14.0.6"
    },
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
